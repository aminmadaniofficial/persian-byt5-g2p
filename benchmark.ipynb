   "source": [
    "# Persian ByT5 G2P Benchmark (Word-Level Pipeline)\n",
    "### Official Sentence-Level Evaluation on SentenceBench (ICASSP 2025)\n",
    "\n",
    "- **Target Model:** [`AminMadani/persian-byt5-g2p`](https://huggingface.co/AminMadani/persian-byt5-g2p)\n",
    "- **Dataset:** [`MahtaFetrat/SentenceBench`](https://huggingface.co/datasets/MahtaFetrat/SentenceBench) (400 sentences)\n",
    "- **Methodology:** Standard Word-Level G2P pipeline (splits sentences into lexical words, passes words as batched inputs to ByT5, eliminates early-stopping truncation)\n",
    "- **Hardware:** Google Colab **T4 GPU** (Runtime ~15-20 seconds)\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install Required Libraries\n",
    "!pip install -q transformers datasets pandas editdistance tqdm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Load Model & Benchmark Dataset\n",
    "import re\n",
    "import pandas as pd\n",
    "import torch\n",
    "import editdistance\n",
    "from tqdm import tqdm\n",
    "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\n",
    "\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Active Device: {DEVICE.upper()} (GPU: {torch.cuda.is_available()})\")\n",
    "\n",
    "MODEL_ID = \"AminMadani/persian-byt5-g2p\"\n",
    "print(f\"Loading {MODEL_ID}...\")\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)\n",
    "model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_ID).to(DEVICE)\n",
    "model.eval()\n",
    "\n",
    "print(\"Fetching SentenceBench dataset from Hugging Face...\")\n",
    "CSV_URL = \"https://huggingface.co/datasets/MahtaFetrat/SentenceBench/resolve/main/SentenceBench.csv\"\n",
    "df = pd.read_csv(CSV_URL)\n",
    "print(f\"Loaded {len(df)} sentences across subsets: {dict(df['dataset'].value_counts())}\")\n",
    "display(df.head(3))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Word-Level Transcription Pipeline (Zero Early-Stopping Truncation)\n",
    "def clean_phoneme_string(text: str) -> str:\n",
    "    \"\"\"Extract only valid Persian phonemes (A-Z, a-z, ?).\"\"\"\n",
    "    if not isinstance(text, str):\n",
    "        return \"\"\n",
    "    return re.sub(r\"[^A-Za-z?]\", \"\", text)\n",
    "\n",
    "def predict_sentence_word_level(sentence: str) -> str:\n",
    "    \"\"\"\n",
    "    Standard G2P Pipeline:\n",
    "    Splits sentence into lexical words, passes words as a batch to ByT5,\n",
    "    and rejoins transcribed phonemes. Eliminates early-stopping bugs.\n",
    "    \"\"\"\n",
    "    raw_words = sentence.strip().split()\n",
    "    clean_words = [re.sub(r\"[!?,.:;()،؟«»\\\"']\", \"\", w).strip() for w in raw_words]\n",
    "    clean_words = [w for w in clean_words if w]\n",
    "    \n",
    "    if not clean_words:\n",
    "        return \"\"\n",
    "    \n",
    "    # Batch encode all words in the sentence (matches KaamelDict word-level format)\n",
    "    inputs = tokenizer(\n",
    "        clean_words, \n",
    "        return_tensors=\"pt\", \n",
    "        padding=True, \n",
    "        truncation=True, \n",
    "        max_length=64\n",
    "    ).to(DEVICE)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        outputs = model.generate(\n",
    "            **inputs,\n",
    "            max_length=64,\n",
    "            num_beams=1,      # Greedy decoding: No early-stopping cutoff & ultra-fast!\n",
    "            do_sample=False\n",
    "        )\n",
    "    \n",
    "    # Decode and remove intra-phoneme spaces\n",
    "    decoded_phonemes = []\n",
    "    for out in outputs:\n",
    "        p = tokenizer.decode(out, skip_special_tokens=True).strip()\n",
    "        decoded_phonemes.append(clean_phoneme_string(p))\n",
    "        \n",
    "    return \"\".join(decoded_phonemes)\n",
    "\n",
    "print(\"Word-level pipeline function initialized!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Run Benchmark Evaluation on all 400 Sentences\n",
    "print(\"Running word-level benchmark (takes ~15-20s on T4 GPU)...\\n\")\n",
    "results = []\n",
    "homograph_correct = 0\n",
    "total_homographs = 0\n",
    "\n",
    "for i, row in tqdm(df.iterrows(), total=len(df)):\n",
    "    grapheme = str(row[\"grapheme\"]).strip()\n",
    "    ref_phonemes = clean_phoneme_string(str(row[\"phoneme\"]))\n",
    "    pred_phonemes = predict_sentence_word_level(grapheme)\n",
    "    \n",
    "    dist = editdistance.eval(list(pred_phonemes), list(ref_phonemes))\n",
    "    ref_len = max(len(ref_phonemes), 1)\n",
    "    per = dist / ref_len\n",
    "    \n",
    "    is_homograph = (row[\"dataset\"] == \"homograph\") and pd.notna(row.get(\"homograph word\"))\n",
    "    homo_match = None\n",
    "    if is_homograph:\n",
    "        target_pron = clean_phoneme_string(str(row[\"pronunciation\"]))\n",
    "        homo_match = target_pron in pred_phonemes\n",
    "        total_homographs += 1\n",
    "        if homo_match:\n",
    "            homograph_correct += 1\n",
    "            \n",
    "    results.append({\n",
    "        \"dataset\": row[\"dataset\"],\n",
    "        \"grapheme\": grapheme,\n",
    "        \"ref\": ref_phonemes,\n",
    "        \"pred\": pred_phonemes,\n",
    "        \"dist\": dist,\n",
    "        \"ref_len\": ref_len,\n",
    "        \"per\": per,\n",
    "        \"homo_match\": homo_match\n",
    "    })\n",
    "\n",
    "res_df = pd.DataFrame(results)\n",
    "\n",
    "# Aggregate Results\n",
    "total_dist = res_df[\"dist\"].sum()\n",
    "total_ref_len = res_df[\"ref_len\"].sum()\n",
    "overall_per = (total_dist / total_ref_len) * 100\n",
    "\n",
    "print(\"\\n\" + \"=\"*65)\n",
    "print(\"📊 OFFICIAL BENCHMARK RESULTS (Word-Level Pipeline)\")\n",
    "print(\"=\"*65)\n",
    "print(f\"Overall Phoneme Error Rate (PER): {overall_per:.2f}%\")\n",
    "\n",
    "for ds_name, group in res_df.groupby(\"dataset\"):\n",
    "    subset_per = (group[\"dist\"].sum() / group[\"ref_len\"].sum()) * 100\n",
    "    print(f\"  • {ds_name.upper():12} PER: {subset_per:.2f}% ({len(group)} sentences)\")\n",
    "\n",
    "if total_homographs > 0:\n",
    "    homo_acc = (homograph_correct / total_homographs) * 100\n",
    "    print(f"\n🎯 Homograph Word Accuracy:     {homo_acc:.2f}% ({homograph_correct}/{total_homographs})\")\n",
    "print(\"=\"*65)\n",
    "\n",
    "# Sample Qualitative Output\n",
    "print(\"\\n--- Sample Predictions vs Ground Truth ---\")\n",
    "for _, r in res_df.sample(5, random_state=42).iterrows():\n",
    "    print(f\"Text: {r['grapheme']}\")\n",
    "    print(f\"Ref:  {r['ref']}\")\n",
    "    print(f\"Pred: {r['pred']}\")\n",
    "    print(f\"PER:  {r['per']*100:.1f}%\\n\")"
   ]
  }
